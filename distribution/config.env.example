AIWS_VERSION=0.6.0
AIWS_IMAGE_NAMESPACE=ghcr.io/almaro90
AIWS_ENV=production
AIWS_PUBLIC_URL=https://aiws.example.com
AIWS_ALLOWED_REPO_ROOTS=["/srv/repos"]
AIWS_ADMIN_USERNAME=admin
AIWS_ADMIN_PASSWORD_HASH=generated-by-init-secrets
AIWS_SESSION_SECRET=generated-by-init-secrets
AIWS_NOTIFICATION_ENCRYPTION_KEY=generated-by-init-secrets
AIWS_API_TOKEN_HASH=generated-by-init-secrets
AIWS_RUNNER_TOKEN=generated-by-init-secrets
AIWS_RUNNER_TOKEN_HASH=generated-by-init-secrets
AIWS_RUNNER_CONTROL_SECRET=generated-by-init-secrets
# Optional GitHub App provider: uncomment all three lines together.
# AIWS_GITHUB_APP_ID=replace-with-github-app-id
# AIWS_GITHUB_APP_SLUG=replace-with-github-app-slug
# AIWS_GITHUB_PRIVATE_KEY_BASE64=replace-with-base64-pem-private-key
# Optional Azure DevOps provider: uncomment all three lines together.
# AIWS_AZURE_DEVOPS_CLIENT_ID=replace-with-entra-application-client-id
# AIWS_AZURE_DEVOPS_CLIENT_SECRET=replace-with-entra-application-client-secret
# AIWS_CONNECTION_ENCRYPTION_KEY=replace-with-base64-32-byte-key
AIWS_REPO_ROOT=/srv/repos
AIWS_PORT=3000
AIWS_DOCKER_NETWORK=aiws-runtime
AIWS_REPOSITORIES_VOLUME=aiws-repositories
AIWS_WORKSPACES_VOLUME=aiws-workspaces
AIWS_CODEX_AUTH_VOLUME=aiws-codex-auth
