{
  "name": "aiws",
  "version": "0.8.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && bun run architecture:check",
    "architecture:check": "bun run scripts/check-architecture.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "build": "bun run --filter '*' build",
    "contract:check": "bun run scripts/check-contract.ts",
    "smoke:local": "bun run scripts/smoke.ts",
    "smoke:docker": "bun run scripts/docker-smoke.ts",
    "smoke:distribution": "bun run scripts/distribution-smoke.ts",
    "smoke": "bun run smoke:docker && bun run smoke:distribution"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  }
}
