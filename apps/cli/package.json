{
  "name": "@aiws/cli",
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "bin": {
    "aiws": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "compile:linux-x64": "bun build ./src/index.ts --compile --target=bun-linux-x64 --outfile ./dist/aiws-linux-x64",
    "compile:linux-arm64": "bun build ./src/index.ts --compile --target=bun-linux-arm64 --outfile ./dist/aiws-linux-arm64",
    "compile:darwin-x64": "bun build ./src/index.ts --compile --target=bun-darwin-x64 --outfile ./dist/aiws-darwin-x64",
    "compile:darwin-arm64": "bun build ./src/index.ts --compile --target=bun-darwin-arm64 --outfile ./dist/aiws-darwin-arm64",
    "compile:windows-x64": "bun build ./src/index.ts --compile --target=bun-windows-x64 --outfile ./dist/aiws-windows-x64.exe"
  },
  "dependencies": {
    "@aiws/api-client": "workspace:*",
    "commander": "14.0.2"
  }
}
